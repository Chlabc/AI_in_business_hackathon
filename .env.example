# SpaceXAI (xAI) — playbook parse + live practice scoring (server-side only)
XAI_API_KEY=
# auto (default) = LLM rubric when key present, else heuristic
# llm = require xAI · heuristic = force rule scorer (also what npm run eval uses)
CORNERMAN_SCORING=auto
# Optional model override (default grok-4.5)
# SCORING_LLM_MODEL=grok-4.5

# ElevenLabs — voice client persona (Phase 2+)
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Supabase — manager comments / inbox + practice session logs (transcripts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only — required for comments/inbox/logs (Dashboard → Settings → API)
SUPABASE_SERVICE_ROLE_KEY=
# After setting keys, run supabase/practice_sessions.sql in the SQL editor.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
DEMO_REP_ID=rep_demo_alex
NEXT_PUBLIC_ELEVENLABS_AGENT_ID=

# Demo auth (signed session cookie) — any long random string
AUTH_SECRET=replace-me-with-a-long-random-string
